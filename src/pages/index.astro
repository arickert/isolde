---
import { getCollection, render } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function youtubeEmbedUrl(url: string): string | null {
  let id: string | null = null;
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtu.be')) id = u.pathname.slice(1);
    else if (u.hostname.includes('youtube.com')) id = u.searchParams.get('v');
  } catch {}
  return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
}

const statusIcons: Record<string, string> = {
  current: '★',
  future: '◆',
  past: '',
};

const statusRows: Record<string, string> = {
  current: 'current',
  future: 'current',
  past: 'past',
};

const pages = await getCollection('pages');
pages.sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  pages.map(async (page) => {
    const { Content } = await render(page);
    const status = page.data.status;
    const rawIcon = page.data.icon;
    const icon = rawIcon !== undefined ? rawIcon : (status ? statusIcons[status] : '✕');
    const row = page.data.row ?? (status ? statusRows[status] : 'current');
    return { ...page, Content, icon, row };
  })
);

const featuredCurrent = rendered.filter((p) => p.data.status === 'current' && p.data.featured);
const featuredFuture = rendered.filter((p) => p.data.status === 'future' && p.data.featured);
const featuredPast = rendered.filter((p) => p.data.status === 'past' && p.data.featured);
const currentShows = rendered.filter((p) => p.row === 'current');
const pastShows = rendered.filter((p) => p.row === 'past');
const infoPages = rendered.filter((p) => p.row === 'info');
const autoOpenPages = rendered.filter((p) => p.data.autoOpen);

function extractYear(date?: string): number {
  if (!date) return 0;
  const match = date.match(/(\d{4})/g);
  return match ? parseInt(match[match.length - 1]) : 0;
}

const pastByYear = new Map<number, typeof pastShows>();
for (const show of pastShows) {
  const year = extractYear(show.data.date);
  if (!pastByYear.has(year)) pastByYear.set(year, []);
  pastByYear.get(year)!.push(show);
}
const pastYears = [...pastByYear.keys()].sort((a, b) => b - a);
---

<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Isolde</title>
  <meta name="base" content={base} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Goudy+Bookletter+1911&display=swap" rel="stylesheet" />
  <style set:html={`
    @font-face {
      font-family: 'Monument Grotesk Variable';
      src: url('${base}/fonts/MonumentGrotesk-Regular.woff2') format('woff2');
      font-weight: 200 1000;
      font-style: normal;
      font-display: swap;
    }
  `} />
</head>
<body>
  <div class="page">
    <h1 class="title">Isolde</h1>

    <a href="#" class="hero-link" data-window="information">
      <img
        class="hero-image"
        src={`${base}/images/Isolde_Windows_ASCII.png`}
        alt=""
        loading="eager"
      />
    </a>

    <!-- <p class="tagline">Isolde is an artist-run project space for exhibitions, performances, and experimental work.</p> -->

    <div class="show-ticker">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <Fragment>
            {featuredFuture.map((page) => (
              <a href="#" class="ticker-item" data-window={page.id}>
                <span class="nav-label">Future</span>
                {page.data.artists
                  ? <Fragment><strong>{page.data.artists}</strong> <em>{page.data.title}</em></Fragment>
                  : page.data.title}
              </a>
            ))}
            {featuredCurrent.map((page) => (
              <a href="#" class="ticker-item" data-window={page.id}>
                <span class="nav-label">Current</span>
                {page.data.artists
                  ? <Fragment><strong>{page.data.artists}</strong> <em>{page.data.title}</em></Fragment>
                  : page.data.title}
              </a>
            ))}
            {featuredPast.map((page) => (
              <a href="#" class="ticker-item" data-window={page.id}>
                <span class="nav-label">Past</span>
                {page.data.artists
                  ? <Fragment><strong>{page.data.artists}</strong> <em>{page.data.title}</em></Fragment>
                  : page.data.title}
              </a>
            ))}
          </Fragment>
        ))}
      </div>
    </div>

    <div class="info-row">
      {infoPages.map((page) => (
        <a href="#" class="nav-item" data-window={page.id}>
          {page.icon.endsWith('.svg')
            ? <img class="nav-icon" src={`${base}${page.icon}`} alt="" />
            : page.icon ? <Fragment>{page.icon}&thinsp;</Fragment> : null}{page.data.title}
        </a>
      ))}
      {pastShows.length > 0 && (
        <a href="#" class="nav-item" id="archive-toggle">Archive</a>
      )}
      <span class="nav-item" style="cursor: default; opacity: 0.5;">Shop</span>
    </div>

    <div class="social">
      <a href="mailto:info@isolde.nyc"><img class="nav-icon" src={`${base}/icons/mail.svg`} alt="" />&thinsp;Email</a>
      <a href="https://www.are.na/isolde-nyc/channels"><img class="nav-icon" src={`${base}/icons/arena.svg`} alt="" />&thinsp;Are.na</a>
      <a href="https://www.instagram.com/isolde.nyc"><img class="nav-icon" src={`${base}/icons/instagram.svg`} alt="" />&thinsp;Instagram</a>
      <a href="#" class="newsletter-toggle" id="newsletter-toggle"><img class="nav-icon" src={`${base}/icons/mail.svg`} alt="" />&thinsp;Newsletter</a>
    </div>

    <div class="newsletter-overlay" id="newsletter-overlay">
      <div class="newsletter-modal">
        <div class="window-header">
          <button class="window-close" id="newsletter-close" aria-label="Close">&times;</button>
        </div>
        <div class="newsletter-modal-content">
          <h2 class="newsletter-title">Newsletter</h2>
          <form action="https://buttondown.com/api/emails/embed-subscribe/isolde.nyc" method="post" class="embeddable-buttondown-form">
            <input type="email" name="email" id="bd-email" placeholder="Enter your email" required />
            <input type="submit" value="Subscribe" />
          </form>
        </div>
      </div>
    </div>

  </div>


  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close">&times;</button>
    <button class="lightbox-prev" id="lightbox-prev">&#8249;</button>
    <button class="lightbox-next" id="lightbox-next">&#8250;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  </div>

  <!-- Overlay windows -->
  <div class="windows-layer">
    <!-- Archive window -->
    <div class="window" id="window-archive" style="width: 500px;">
      <div class="window-header">
        <button class="window-close" aria-label="Close">&times;</button>
      </div>
      <div class="window-content archive-content">
        <h1 class="window-title">Archive</h1>
        {pastYears.map((year, yi) => (
          <div class="archive-year" data-year={year}>
            <button class="archive-year-header" data-expanded={yi === 0 ? "true" : "false"}>
              <span class="archive-year-arrow">{yi === 0 ? '−' : '+'}</span>
              <span>{year || 'Undated'}</span>
            </button>
            <div class="archive-year-list" style={yi === 0 ? '' : 'display:none;'}>
              {pastByYear.get(year)!.map((show) => (
                <a href="#" class="archive-show" data-window={show.id}>
                  <span class="archive-show-title">
                    {show.data.artists
                      ? <Fragment><strong>{show.data.artists}</strong> <em>{show.data.title}</em></Fragment>
                      : show.data.title}
                  </span>
                  {show.data.date && <span class="archive-show-date">{show.data.date}</span>}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    {rendered.map((page) => (
      <div class="window" id={`window-${page.id}`} style={`width: ${page.data.width}px; background: ${page.data.color};`} {...(page.data.autoOpen ? {'data-auto-open': ''} : {})}>
        <div class="window-header">
          <button class="window-close" aria-label="Close">&times;</button>
        </div>
        <div class="window-content">
          {page.data.artists && <p class="window-artists">{page.data.artists}</p>}
          <h1 class="window-title">{page.data.title}</h1>
          {page.data.date && <p class="window-date">{page.data.date}</p>}
          {page.data.images && page.data.images.length > 0 && (
            <div class="window-carousel" data-index="0">
              <div class="carousel-viewport">
                <img class="carousel-img" src={page.data.images[0]} alt="" />
              </div>
              {page.data.images.length > 1 && (
                <button class="carousel-prev" aria-label="Previous"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              )}
              {page.data.images.length > 1 && (
                <button class="carousel-next" aria-label="Next"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              )}
              {page.data.images.length > 1 && (
                <div class="carousel-counter">
                  <span class="carousel-current">1</span> / {page.data.images.length}
                </div>
              )}
              <div class="carousel-sources" style="display:none;">
                {page.data.images.map((img: string) => (
                  <span data-src={img} />
                ))}
              </div>
            </div>
          )}
          <div class="window-body">
            <page.Content />
          </div>
          {page.data.videos && page.data.videos.length > 0 && (
            <div class="window-videos">
              {page.data.videos.map((url: string) => {
                const embed = youtubeEmbedUrl(url);
                return embed ? (
                  <div class="video-wrapper">
                    <iframe src={embed} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                  </div>
                ) : null;
              })}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  <script>
    function clamp(n: number, min: number, max: number) {
      return Math.max(min, Math.min(max, n));
    }

    function isMobile() {
      return window.innerWidth <= 678;
    }

    let highestZ = 100;

    function bringToFront(win: HTMLElement) {
      highestZ++;
      win.style.zIndex = String(highestZ);
    }

    function randomizePosition(win: HTMLElement) {
      requestAnimationFrame(() => {
        const rect = win.getBoundingClientRect();
        const maxX = Math.max(0, window.innerWidth - rect.width);
        const maxY = Math.max(0, window.innerHeight - rect.height);
        const minX = Math.floor(maxX * 0.2);
        const maxX2 = Math.floor(maxX * 0.8);
        const minY = Math.floor(maxY * 0.02);
        const maxY2 = Math.floor(maxY * 0.35);
        const x = maxX2 > minX
          ? minX + Math.floor(Math.random() * (maxX2 - minX + 1))
          : Math.floor(maxX / 2);
        const y = maxY2 > minY
          ? minY + Math.floor(Math.random() * (maxY2 - minY + 1))
          : Math.floor(maxY / 2);
        win.style.left = x + 'px';
        win.style.top = y + 'px';
      });
    }

    function updateBodyScroll() {
      const anyOpen = document.querySelectorAll('.window.open').length > 0;
      document.body.classList.toggle('has-open-window', anyOpen && isMobile());
    }

    function openWindow(id: string) {
      const win = document.getElementById(`window-${id}`);
      if (!win) return;

      if (win.classList.contains('open')) {
        bringToFront(win);
        return;
      }

      win.classList.add('open');
      bringToFront(win);

      if (!isMobile()) {
        randomizePosition(win);
      }

      updateBodyScroll();
    }

    function closeWindow(win: HTMLElement) {
      win.classList.remove('open');
      updateBodyScroll();
    }

    function closeAllWindows() {
      document.querySelectorAll<HTMLElement>('.window.open').forEach((win) => {
        win.classList.remove('open');
      });
      updateBodyScroll();
    }

    // Nav + hero link clicks
    document.querySelectorAll<HTMLElement>('[data-window]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const id = el.dataset.window;
        if (id) openWindow(id);
      });
    });

    document.querySelectorAll<HTMLElement>('[data-action="home"]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        closeAllWindows();
      });
    });

    // Close buttons
    document.querySelectorAll<HTMLButtonElement>('.window-close').forEach((btn) => {
      btn.addEventListener('click', () => {
        const win = btn.closest('.window') as HTMLElement | null;
        if (win) closeWindow(win);
      });
    });

    // Pointer-based dragging (matches Cargo behavior)
    document.querySelectorAll<HTMLElement>('.window').forEach((win) => {
      let dragging = false;
      let startX = 0, startY = 0;
      let originLeft = 0, originTop = 0;

      win.addEventListener('pointerdown', (e) => {
        if (isMobile()) return;
        if ((e.target as HTMLElement).closest('a, button, input, textarea, select, img')) return;

        const rect = win.getBoundingClientRect();
        const fromRight = rect.right - e.clientX;
        const fromBottom = rect.bottom - e.clientY;
        if (fromRight < 18 && fromBottom < 18) return;

        dragging = true;
        win.classList.add('is-dragging');
        win.setPointerCapture(e.pointerId);
        bringToFront(win);

        startX = e.clientX;
        startY = e.clientY;
        originLeft = rect.left;
        originTop = rect.top;
      });

      win.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const rect = win.getBoundingClientRect();
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        const newLeft = originLeft + dx;
        const newTop = originTop + dy;
        const maxLeft = window.innerWidth - rect.width;
        const maxTop = window.innerHeight - rect.height;
        win.style.left = clamp(newLeft, 0, maxLeft) + 'px';
        win.style.top = clamp(newTop, 0, maxTop) + 'px';
      });

      const stop = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        win.classList.remove('is-dragging');
        try { win.releasePointerCapture(e.pointerId); } catch {}
      };

      win.addEventListener('pointerup', stop);
      win.addEventListener('pointercancel', stop);
    });

    // Clamp windows to viewport on resize
    window.addEventListener('resize', () => {
      document.querySelectorAll<HTMLElement>('.window.open').forEach((win) => {
        if (isMobile()) return;
        const rect = win.getBoundingClientRect();
        const maxLeft = Math.max(0, window.innerWidth - rect.width);
        const maxTop = Math.max(0, window.innerHeight - rect.height);
        win.style.left = clamp(rect.left, 0, maxLeft) + 'px';
        win.style.top = clamp(rect.top, 0, maxTop) + 'px';
      });
    });

    // Lightbox gallery
    const lightbox = document.getElementById('lightbox')!;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close')!;
    const lightboxPrev = document.getElementById('lightbox-prev')!;
    const lightboxNext = document.getElementById('lightbox-next')!;
    let galleryImages: string[] = [];
    let galleryIndex = 0;

    function openLightbox(images: string[], index: number) {
      galleryImages = images;
      galleryIndex = index;
      lightboxImg.src = galleryImages[galleryIndex];
      lightbox.classList.add('open');
      lightboxPrev.style.display = galleryImages.length > 1 ? '' : 'none';
      lightboxNext.style.display = galleryImages.length > 1 ? '' : 'none';
    }

    function closeLightbox() {
      lightbox.classList.remove('open');
      lightboxImg.src = '';
    }

    lightboxClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    lightboxPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      galleryIndex = (galleryIndex - 1 + galleryImages.length) % galleryImages.length;
      lightboxImg.src = galleryImages[galleryIndex];
    });

    lightboxNext.addEventListener('click', (e) => {
      e.stopPropagation();
      galleryIndex = (galleryIndex + 1) % galleryImages.length;
      lightboxImg.src = galleryImages[galleryIndex];
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lightboxPrev.click();
      if (e.key === 'ArrowRight') lightboxNext.click();
    });

    // Carousel navigation
    document.querySelectorAll<HTMLElement>('.window-carousel').forEach((carousel) => {
      const sources = Array.from(carousel.querySelectorAll('.carousel-sources span')).map(
        (s) => (s as HTMLElement).dataset.src!
      );
      const img = carousel.querySelector('.carousel-img') as HTMLImageElement;
      const counter = carousel.querySelector('.carousel-current');
      let idx = 0;

      function showSlide(i: number) {
        idx = (i + sources.length) % sources.length;
        img.src = sources[idx];
        carousel.dataset.index = String(idx);
        if (counter) counter.textContent = String(idx + 1);
      }

      carousel.querySelector('.carousel-prev')?.addEventListener('click', (e) => {
        e.stopPropagation();
        showSlide(idx - 1);
      });
      carousel.querySelector('.carousel-next')?.addEventListener('click', (e) => {
        e.stopPropagation();
        showSlide(idx + 1);
      });

      img.style.cursor = 'zoom-in';
      img.draggable = false;
      img.addEventListener('dragstart', (e) => e.preventDefault());
      img.addEventListener('click', () => {
        openLightbox(sources, idx);
      });
    });

    // Newsletter modal
    const nlToggle = document.getElementById('newsletter-toggle');
    const nlOverlay = document.getElementById('newsletter-overlay');
    const nlClose = document.getElementById('newsletter-close');

    nlToggle?.addEventListener('click', (e) => {
      e.preventDefault();
      nlOverlay?.classList.add('open');
    });

    nlClose?.addEventListener('click', () => {
      nlOverlay?.classList.remove('open');
    });

    nlOverlay?.addEventListener('click', (e) => {
      if (e.target === nlOverlay) {
        nlOverlay.classList.remove('open');
      }
    });

    // Archive popup — uses standard window system
    const archiveToggle = document.getElementById('archive-toggle');
    archiveToggle?.addEventListener('click', (e) => {
      e.preventDefault();
      openWindow('archive');
    });

    document.querySelectorAll('.archive-year-header').forEach((btn) => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('data-expanded') === 'true';
        const list = btn.nextElementSibling as HTMLElement;
        const arrow = btn.querySelector('.archive-year-arrow')!;
        if (expanded) {
          list.style.display = 'none';
          btn.setAttribute('data-expanded', 'false');
          arrow.textContent = '+';
        } else {
          list.style.display = '';
          btn.setAttribute('data-expanded', 'true');
          arrow.textContent = '−';
        }
      });
    });

    document.querySelectorAll('.archive-show').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const windowId = (link as HTMLElement).dataset.window;
        if (windowId) openWindow(windowId);
      });
    });

    document.querySelectorAll<HTMLElement>('.window[data-auto-open]').forEach((win) => {
      const id = win.id.replace('window-', '');
      openWindow(id);
    });

  </script>
</body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    color-scheme: light only;
  }

  body {
    font-family: 'Monument Grotesk Variable', system-ui, -apple-system, sans-serif;
    background: #fff !important;
    color: rgba(0, 0, 0, 0.85) !important;
    min-height: 100vh;
    line-height: 1.2;
    font-size: 1.1rem;
    font-weight: 400;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body.has-open-window {
    overflow: hidden !important;
  }

  a {
    color: rgba(0, 0, 0, 0.85);
    text-decoration: none;
  }

  a:hover {
    color: rgba(158, 145, 145, 0.85);
  }

  a:active {
    opacity: 0.7;
  }

  /* ---- Page ---- */

  .page {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 1rem 1.5rem;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  /* ---- Title ---- */

  .title {
    font-family: 'Goudy Bookletter 1911', Georgia, serif;
    font-size: 3.55rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    color: rgba(158, 145, 145, 0.85);
    position: relative;
    z-index: 2;
    margin-bottom: 1rem;
  }

  /* ---- Hero Image ---- */

  .hero-link {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    margin-top: 0.5rem;
  }

  .hero-link:hover {
    opacity: 0.85;
  }

  .hero-image {
    max-width: 95vw;
    max-height: 110%;
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    transform: scale(1.25);
  }

  /* ---- Tagline ---- */

  .tagline {
    font-family: 'Goudy Bookletter 1911', Georgia, serif;
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1.2;
    color: rgba(0, 0, 0, 0.85);
    max-width: 600px;
    margin-top: 1rem;
    margin-bottom: 0;
    position: relative;
    z-index: 2;
  }

  /* ---- Navigation ---- */

  /* ---- Show Ticker ---- */

  .show-ticker {
    height: 6rem;
    overflow: hidden;
    position: relative;
    z-index: 2;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .ticker-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: ticker-scroll 15s linear infinite;
  }

  .ticker-item {
    font-family: 'Goudy Bookletter 1911', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 2rem;
    color: rgba(0, 0, 0, 0.85);
    cursor: pointer;
    text-decoration: none;
    padding: 0;
    white-space: nowrap;
  }

  .ticker-item:nth-child(1), .ticker-item:nth-child(4) { animation: fade-a 15s linear infinite; }
  .ticker-item:nth-child(2), .ticker-item:nth-child(5) { animation: fade-b 15s linear infinite; }
  .ticker-item:nth-child(3), .ticker-item:nth-child(6) { animation: fade-c 15s linear infinite; }

  .ticker-item strong {
    font-family: 'Monument Grotesk Variable', 'Space Grotesk', sans-serif;
    font-weight: 500;
